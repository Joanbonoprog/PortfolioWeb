---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import PhoneSimulator from '../components/PhoneSimulator.astro';
import AppModal from '../components/AppModal.astro';
import Footer from '../components/Footer.astro';
import { getTranslations, type Language } from '../i18n/index';

// Obtener idioma de la URL o usar español por defecto
const url = Astro.url;
const langParam = url.searchParams.get('lang');
const currentLang: Language = (langParam === 'en' || langParam === 'es') ? langParam as Language : 'es';

// Obtener traducciones
const translations = getTranslations(currentLang);
---

<Layout lang={currentLang} title={`${translations.projects.title} - ${translations.hero.name}`}>
	<Header currentLang={currentLang} translations={translations} showNav={false} showLogo={false} showBackButton={true} />
	
	<main class="h-screen pt-20 overflow-hidden">
		<!-- Phone Simulator Section -->
		<section class="bg-white h-full flex items-center justify-center">
			<PhoneSimulator translations={translations} />
		</section>
	</main>

	<!-- Modal Component -->
	<AppModal translations={translations} />
</Layout>

<style>
	main {
		animation: fadeIn 0.6s ease-out;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
</style>
