---
import Layout from "../layouts/Layout.astro";
import { getTranslations } from "../i18n/index";

const translations = getTranslations("es");
---

<Layout lang="es" title="404 - Página no encontrada">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center max-w-lg mx-auto">
      <p class="text-7xl md:text-9xl font-bold text-blue-600 dark:text-blue-400">404</p>
      <h1 class="mt-4 text-2xl md:text-3xl font-bold text-gray-900 dark:text-white">
        Página no encontrada · Page not found
      </h1>
      <p class="mt-3 text-gray-600 dark:text-gray-400">
        La página que buscas no existe o ha sido movida.<br />
        The page you are looking for doesn't exist or has been moved.
      </p>
      <a
        href="/"
        class="btn-ripple inline-flex items-center gap-2 mt-8 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all hover:scale-105 shadow-lg"
      >
        <span class="material-icons">home</span>
        <span>{translations.header.backToHome}</span>
      </a>
    </div>
  </main>
</Layout>
