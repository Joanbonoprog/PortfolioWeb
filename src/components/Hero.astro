---
interface Props {
  translations: any;
  currentLang: string;
}

const { translations, currentLang } = Astro.props;
const { hero } = translations;
---

<section class="min-h-screen flex items-center justify-center px-6 pt-20 transition-colors duration-300">
  <div class="max-w-4xl mx-auto text-center">
    <div class="mb-8 animate-fade-in" style="animation-delay: 0s; opacity: 0;">
      <div class="w-60 h-60 md:w-72 md:h-72 lg:w-80 lg:h-80 rounded-full mx-auto overflow-hidden shadow-2xl border-4 border-white dark:border-gray-700 hover:scale-105 hover:rotate-3 transition-all duration-500 cursor-pointer group">
        <img 
          src="/FotoPortfolio.jpg" 
          alt="Joan Bono Frígols" 
          class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
          style="object-position: center 30%;" 
        />
      </div>
    </div>

    <!-- Greeting -->
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-4 animate-fade-in" style="animation-delay: 0.1s; opacity: 0;" data-i18n="hero.greeting">
      {hero.greeting}
    </p>

    <!-- Name -->
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 dark:text-white mb-6 animate-fade-in" style="animation-delay: 0.2s; opacity: 0;">
      {hero.name}
    </h1>

    <!-- Title with Typewriter Effect -->
    <h2 id="typewriter-title" class="text-2xl md:text-3xl lg:text-4xl text-indigo-600 dark:text-indigo-400 font-semibold mb-20 min-h-[3rem]">
      <span class="typewriter-text"></span><span class="typewriter-cursor">|</span>
    </h2>

    <!-- Scroll Indicator -->
    <a href="#contact" class="scroll-indicator block mt-65 animate-bounce cursor-pointer group">
      <span class="material-icons text-4xl text-gray-700 dark:text-gray-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-all duration-300 group-hover:scale-125 group-hover:drop-shadow-lg">
        keyboard_arrow_down
      </span>
    </a>
  </div>
</section>

<script>
  // Efecto typewriter
  function initTypewriter() {
    const typewriterText = document.querySelector('.typewriter-text');
    
    if (!typewriterText) return;

    // Limpiar cualquier contenido previo
    typewriterText.textContent = '';

    // Leer de window.__i18n__ (fuente de verdad SSR)
    const urlParams = new URLSearchParams(window.location.search);
    const currentLang = urlParams.get('lang') || 'es';
    const text = window.__i18n__?.[currentLang]?.hero?.title
      || window.__i18n__?.['es']?.hero?.title
      || '';
    let index = 0;
    
    function typeWriter() {
      if (index < text.length && typewriterText) {
        typewriterText.textContent += text.charAt(index);
        index++;
        setTimeout(typeWriter, 80);
      }
    }
    
    // Iniciar después de 1 segundo
    setTimeout(typeWriter, 1000);
  }
  
  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTypewriter);
  } else {
    initTypewriter();
  }
</script>

<style>
  .typewriter-cursor {
    animation: blink 1s step-end infinite;
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>

