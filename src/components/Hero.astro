---
interface Props {
  translations: any;
  currentLang: string;
}

const { translations, currentLang } = Astro.props;
const { hero } = translations;
---

<section class="min-h-screen flex items-center justify-center px-6 pt-20">
  <div class="max-w-4xl mx-auto text-center">
    <!-- Profile Photo -->
    <div class="mb-8 animate-fade-in" style="animation-delay: 0s; opacity: 0;">
      <div class="w-60 h-60 md:w-72 md:h-72 lg:w-80 lg:h-80 rounded-full mx-auto overflow-hidden shadow-2xl border-4 border-white">
        <img 
          src="/FotoPorfolio.png" 
          alt="Joan Bono Frigols" 
          class="w-full h-full object-cover scale-110"
          style="object-position: 90% 5%;"
        />
      </div>
    </div>

    <!-- Greeting -->
    <p class="text-lg md:text-xl text-gray-600 mb-4 animate-fade-in" style="animation-delay: 0.1s; opacity: 0;" data-i18n="hero.greeting">
      {hero.greeting}
    </p>

    <!-- Name -->
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 mb-6 animate-fade-in" style="animation-delay: 0.2s; opacity: 0;">
      {hero.name}
    </h1>

    <!-- Title -->
    <h2 class="text-2xl md:text-3xl lg:text-4xl text-blue-600 font-semibold mb-20 animate-fade-in" style="animation-delay: 0.3s; opacity: 0;" data-i18n="hero.title">
      {hero.title}
    </h2>

    <!-- Scroll Indicator -->
    <a href="#contact" class="block mt-65 animate-bounce cursor-pointer hover:text-blue-800 transition-colors">
      <span class="material-icons text-4xl text-gray-750 hover:text-blue-800 transition-colors">
        keyboard_arrow_down
      </span>
    </a>
  </div>
</section>

<style>
  section {
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  }
</style>
