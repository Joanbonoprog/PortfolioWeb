---
import { getTranslations, type Language } from '../i18n';

// Obtener idioma de la URL
const url = Astro.url;
const langParam = url.searchParams.get('lang');
const currentLang: Language = (langParam === 'en' || langParam === 'es') ? langParam as Language : 'es';
const translations = getTranslations(currentLang);
const { footer } = translations;
---

<footer class="bg-white/70 dark:bg-gray-900/70 backdrop-blur-sm text-gray-900 dark:text-white py-12 px-6 transition-colors duration-300">
  <div class="max-w-6xl mx-auto text-center">
    <!-- Tech Stack Section -->
    <h3 class="text-gray-600 dark:text-gray-400 text-sm font-semibold uppercase tracking-wider mb-6" data-i18n="footer.builtWith">
      {footer.builtWith}
    </h3>
    <div class="flex flex-wrap items-center justify-center gap-8 mb-8">
      {footer.techStack.map((tech: any) => (
        <a
          href={tech.url}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-ripple group flex flex-col items-center gap-2 hover:scale-110 transition-transform"
          title={tech.name}
        >
          <div class="w-12 h-12 bg-gray-200 dark:bg-gray-800 rounded-lg p-2 flex items-center justify-center group-hover:bg-gray-300 dark:group-hover:bg-gray-700 transition-colors">
            {tech.logoDark ? (
              <>
                <img src={tech.logo} alt={tech.name} loading="lazy" class="w-full h-full object-contain dark:hidden" />
                <img src={tech.logoDark} alt={tech.name} loading="lazy" class="w-full h-full object-contain hidden dark:block" />
              </>
            ) : (
              <img src={tech.logo} alt={tech.name} loading="lazy" class="w-full h-full object-contain" />
            )}
          </div>
          <span class="text-gray-600 dark:text-gray-400 text-xs group-hover:text-gray-900 dark:group-hover:text-white transition-colors">
            {tech.name}
          </span>
        </a>
      ))}
    </div>

    <!-- Divider -->
    <div class="border-t border-gray-300 dark:border-gray-700 my-8"></div>

    <!-- Copyright -->
    <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
      © {new Date().getFullYear()} Joan Bono Frígols. <span data-i18n-content="Todos los derechos reservados">Todos los derechos reservados</span>.
    </p>
  </div>
</footer>
