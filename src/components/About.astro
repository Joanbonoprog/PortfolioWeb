---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
const { about, education, languages } = translations;
---

<section id="about" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-12 text-center" data-i18n="about.title">
      {about.title}
    </h2>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- About Description -->
      <div class="space-y-6">
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200 hover:border-blue-300 transition-all">
          <p class="text-lg text-gray-700 leading-relaxed" data-i18n="about.description">
            {about.description}
          </p>
        </div>

        <!-- Languages -->
        <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200 hover:border-blue-300 transition-all">
          <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
            <span class="material-icons text-blue-600">language</span>
            <span data-i18n="languages.title">{languages.title}</span>
          </h3>
          <ul class="space-y-2">
            {languages.items.map((lang: string) => (
              <li class="text-gray-700 flex items-center gap-2">
                <span class="w-2 h-2 bg-blue-600 rounded-full"></span>
                {lang}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Education -->
      <div class="space-y-6">
        <h3 class="text-2xl font-semibold text-gray-900 mb-6 flex items-center gap-2">
          <span class="material-icons text-blue-600">school</span>
          <span data-i18n="education.title">{education.title}</span>
        </h3>
        
        {education.items.map((edu: any) => (
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-2xl border border-blue-200 hover:shadow-lg transition-all">
            <h4 class="text-xl font-semibold text-gray-900 mb-2">
              {edu.title}
            </h4>
            <p class="text-blue-600 font-medium mb-1">
              {edu.type}
            </p>
            <p class="text-gray-600">
              {edu.institution} • {edu.year}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
