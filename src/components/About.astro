---
interface Props {
  translations: any;
}

const { translations} = Astro.props;
const { about, languages } = translations;
---

<section id="about" class="py-20 px-6 bg-white">
  <div class="max-w-6xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-12 text-center" data-i18n="about.title">
      {about.title}
    </h2>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- About Description -->
      <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200 hover:border-blue-300 transition-all">
        <p class="text-gray-700 leading-relaxed whitespace-pre-line" data-i18n="about.description">
          {about.description}
        </p>
      </div>

      <!-- Languages -->
      <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200 hover:border-blue-300 transition-all">
        <h3 class="text-xl font-semibold text-gray-900 mb-4 flex items-center gap-2">
          <span class="material-icons text-blue-600">language</span>
          <span data-i18n="languages.title">{languages.title}</span>
        </h3>
        <ul class="space-y-3">
          {languages.items.map((lang: string) => (
            <li class="text-gray-700 flex items-start gap-3">
              <span class="text-blue-600 mt-0.5 text-xl">•</span>
              <span class="flex-1">{lang}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
