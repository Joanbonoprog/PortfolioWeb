---
import type { Translations, ExperienceItem } from '../../types/translations';
import SectionHeading from '../ui/SectionHeading.astro';
import BentoCard from '../ui/BentoCard.astro';
import BulletList from '../ui/BulletList.astro';
import LinkButton from '../ui/LinkButton.astro';
import InfoRow from '../ui/InfoRow.astro';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
const { experience } = translations;
---

<section id="experience" class="py-20 transition-colors duration-300">
    <div class="max-w-7xl mx-auto px-6">
      <SectionHeading icon="work" title={experience.title} subtitle={experience.subtitle} />

    <div class="grid md:grid-cols-2 gap-8 items-start">
      {experience.items.map((exp: ExperienceItem) => {
        const iconType = exp.icon.startsWith('/') ? 'image' : 
                         (exp.icon.length < 10 && !exp.icon.includes('📱') && !exp.icon.includes('🎨')) ? 'material' : 'emoji';
        
        return (
          <BentoCard
            icon={exp.icon}
            iconType={iconType}
            current={exp.current}
            currentLabel={experience.current}
            altText={exp.company}
          >
            <h3 slot="title" class="text-2xl font-bold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
              {exp.role}
            </h3>
            <div slot="subtitle">
              <p class="text-blue-600 dark:text-blue-400 font-medium mb-1">
                {exp.company}
              </p>
              <InfoRow icon="calendar_today" size="sm">{exp.period}</InfoRow>
            </div>
            <div slot="content">
              {exp.description.includes('|') ? (
                <BulletList items={exp.description.split('|')} bulletColor="blue" className="space-y-3 mb-6" />
              ) : (
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6">
                  {exp.description}
                </p>
              )}
            </div>
            <div slot="footer">
              {exp.website && (
                <LinkButton
                  href={exp.website}
                  icon="language"
                  variant="primary"
                  dataPreviewId={exp.website.includes('artimark') ? "artimark" : undefined}
                >
                  {experience.visitWebsite}
                </LinkButton>
              )}
            </div>
          </BentoCard>
        );
      })}
    </div>
  </div>
</section>
