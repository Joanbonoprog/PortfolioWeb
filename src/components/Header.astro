---
interface Props {
  currentLang: string;
  translations: any;
  showNav?: boolean;
  showLogo?: boolean;
  showBackButton?: boolean;
}

const { currentLang, translations, showNav = true, showLogo = false, showBackButton = false } = Astro.props;
const { nav } = translations;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/80 backdrop-blur-md border-b border-gray-200">
  <nav class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between relative">
    <!-- Back Button (izquierda en página de proyectos) -->
    {showBackButton ? (
      <a 
        href={`/?lang=${currentLang}`}
        class="flex items-center gap-2 px-4 py-2 bg-gray-900 text-white rounded-full hover:bg-gray-800 transition-all hover:scale-105 shadow-md font-medium"
        data-i18n-content="Volver al Inicio"
      >
        <span class="material-icons text-sm">arrow_back</span>
        <span>{currentLang === 'es' ? 'Volver al Inicio' : 'Back to Home'}</span>
      </a>
    ) : showNav && (
      <div class="flex-1"></div>
    )}

    <!-- Navigation Links centrados (solo en página principal) -->
    {showNav && (
      <div class="flex items-center gap-6 absolute left-1/2 transform -translate-x-1/2">
        <a href="#contact" class="text-gray-700 hover:text-blue-600 transition-colors font-medium" data-i18n="nav.contact" data-i18n-content={nav.contact}>
          {nav.contact}
        </a>
        <a href="#about" class="text-gray-700 hover:text-blue-600 transition-colors font-medium" data-i18n="nav.about" data-i18n-content={nav.about}>
          {nav.about}
        </a>
        <a href="#education" class="text-gray-700 hover:text-blue-600 transition-colors font-medium" data-i18n="nav.education" data-i18n-content={nav.education || 'Educación'}>
          {nav.education || 'Educación'}
        </a>
        <a href="#projects" class="text-gray-700 hover:text-blue-600 transition-colors font-medium" data-i18n="nav.projects" data-i18n-content={nav.projects || 'Proyectos'}>
          {nav.projects || 'Proyectos'}
        </a>
        <a href="#experience" class="text-gray-700 hover:text-blue-600 transition-colors font-medium" data-i18n="nav.experience" data-i18n-content={nav.experience || 'Experiencia'}>
          {nav.experience || 'Experiencia'}
        </a>
        <a href="#skills" class="text-gray-700 hover:text-blue-600 transition-colors font-medium" data-i18n="nav.skills" data-i18n-content={nav.skills}>
          {nav.skills}
        </a>
      </div>
    )}

    <!-- Language Selector a la derecha -->
    <div class="flex items-center gap-4 ml-auto">
      <select 
        id="language-selector" 
        class="px-3 py-2 rounded-lg border border-gray-300 bg-white text-gray-700 font-medium cursor-pointer hover:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all"
        onchange="window.location.href = window.location.pathname + '?lang=' + this.value"
      >
        <option value="es" selected={currentLang === 'es'}>🇪🇸 ES</option>
        <option value="en" selected={currentLang === 'en'}>🇬🇧 EN</option>
      </select>
    </div>
  </nav>
</header>

<script>
  // Establecer el valor del selector basado en la URL
  const urlParams = new URLSearchParams(window.location.search);
  const currentLang = urlParams.get('lang') || 'es';
  const selector = document.getElementById('language-selector') as HTMLSelectElement;
  if (selector) {
    selector.value = currentLang;
    console.log('Idioma actual:', currentLang);
  }
</script>

<style>
  header {
    animation: slideDown 0.4s ease-out;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(0);
    }
  }
</style>
