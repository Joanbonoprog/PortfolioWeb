---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
const { contact } = translations;
---

<section id="contact" class="py-20 px-6 transition-colors duration-300">
  <div class="max-w-4xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 text-center" data-i18n="contact.title">
      {contact.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto" data-i18n="contact.subtitle">
      {contact.subtitle}
    </p>

    <!-- Contact Cards -->
    <div class="grid md:grid-cols-2 gap-6">
      <!-- Phone -->
      <div class="animate-card bg-gradient-to-br from-gray-50/50 to-gray-50/50 dark:from-blue-900/80 dark:to-indigo-900/80 backdrop-blur-md p-8 rounded-2xl border border-blue-200 dark:border-blue-700 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group">
        <div class="flex items-center gap-4 mb-3">
          <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center">
            <span class="material-icons text-white">phone</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white" data-i18n="contact.phone">
            {contact.phone}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-lg">
          {contact.phoneValue}
        </p>
      </div>

      <!-- Email -->
      <div class="animate-card bg-gradient-to-br from-gray-50/50 to-gray-50/50 dark:from-purple-900/80 dark:to-pink-900/80 backdrop-blur-md p-8 rounded-2xl border border-purple-200 dark:border-purple-700 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group">
        <div class="flex items-center gap-4 mb-3">
          <div class="w-12 h-12 bg-purple-600 rounded-full flex items-center justify-center">
            <span class="material-icons text-white">email</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white" data-i18n="contact.email">
            {contact.email}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-lg break-all">
          {contact.emailValue}
        </p>
      </div>

      <!-- Address -->
      <div class="animate-card bg-gradient-to-br from-gray-50/50 to-gray-50/50 dark:from-green-900/80 dark:to-emerald-900/80 backdrop-blur-md p-8 rounded-2xl border border-green-200 dark:border-green-700 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group">
        <div class="flex items-center gap-4 mb-3">
          <div class="w-12 h-12 bg-green-600 rounded-full flex items-center justify-center">
            <span class="material-icons text-white">location_on</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white" data-i18n="contact.address">
            {contact.address}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-lg" data-i18n="contact.addressValue">
          {contact.addressValue}
        </p>
      </div>

      <!-- LinkedIn -->
      <a 
        href={`https://${contact.linkedinValue}`}
        target="_blank"
        rel="noopener noreferrer"
        class="animate-card bg-gradient-to-br from-gray-50/50 to-gray-50/50 dark:from-cyan-900/80 dark:to-blue-900/80 backdrop-blur-md p-8 rounded-2xl border border-cyan-200 dark:border-cyan-700 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center gap-4 mb-3">
          <div class="w-12 h-12 bg-cyan-600 rounded-full flex items-center justify-center">
            <span class="material-icons text-white">business</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white" data-i18n="contact.linkedin">
            {contact.linkedin}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-lg flex items-center gap-2">
          {contact.linkedinValue}
          <span class="material-icons text-cyan-600">open_in_new</span>
        </p>
      </a>
    </div>
  </div>
</section>
