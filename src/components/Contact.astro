---
import type { Translations } from '../types/translations';
import type { Language } from '../i18n/index';

interface Props {
  translations: Translations;
  currentLang?: Language;
}

const { translations, currentLang = 'es' } = Astro.props;
const { contact } = translations;
---

<section id="contact" class="py-20 px-6 transition-colors duration-300">
  <div class="max-w-4xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 text-center">
      {contact.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      {contact.subtitle}
    </p>

    <!-- Contact Cards - Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-auto">
      <!-- Email - Grande (2 columnas) -->
      <button
        id="email-copy-btn"
        data-email={contact.emailValue}
        aria-label={currentLang === 'es' ? 'Copiar email al portapapeles' : 'Copy email to clipboard'}
        class="animate-card card-shimmer bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-8 rounded-2xl border border-gray-200 dark:border-gray-600 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 hover:border-blue-500 dark:hover:border-blue-400 transition-all duration-300 group cursor-pointer w-full text-left active:scale-95 md:col-span-2"
      >
        <div class="flex items-center gap-4 mb-3">
          <div class="w-12 h-12 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
            <span class="material-icons text-blue-600 dark:text-blue-400">email</span>
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
            {contact.email}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-lg break-all flex items-center gap-2">
          <span>{contact.emailValue}</span>
          <span class="material-icons text-sm text-blue-600 dark:text-blue-400 opacity-0 group-hover:opacity-100 transition-opacity">content_copy</span>
        </p>
      </button>

      <!-- Phone - Pequeña -->
      <div class="animate-card card-shimmer bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-6 rounded-2xl border border-gray-200 dark:border-gray-600 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
            <span class="material-icons text-blue-600 dark:text-blue-400 text-xl">phone</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            {contact.phone}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm">
          {contact.phoneValue}
        </p>
      </div>

      <!-- LinkedIn - Mediana -->
      <a 
        href={contact.linkedinValue.startsWith('http') ? contact.linkedinValue : `https://${contact.linkedinValue}`}
        target="_blank"
        rel="noopener noreferrer"
        data-preview-id="linkedin"
        class="animate-card card-shimmer btn-ripple bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-6 rounded-2xl border border-gray-200 dark:border-gray-600 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
            <span class="material-icons text-blue-600 dark:text-blue-400 text-xl">business</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            {contact.linkedin}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="break-all">{contact.linkedinValue}</span>
          <span class="material-icons text-blue-600 dark:text-blue-400 flex-shrink-0 text-sm">open_in_new</span>
        </p>
      </a>

      <!-- GitHub - Mediana -->
      <a 
        href={contact.githubValue?.startsWith('http') ? contact.githubValue : `https://${contact.githubValue}`}
        target="_blank"
        rel="noopener noreferrer"
        class="animate-card card-shimmer btn-ripple bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-6 rounded-2xl border border-gray-200 dark:border-gray-600 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group"
      >
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
            <span class="material-icons text-blue-600 dark:text-blue-400 text-xl">code</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            {contact.github}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="break-all">{contact.githubValue}</span>
          <span class="material-icons text-blue-600 dark:text-blue-400 flex-shrink-0 text-sm">open_in_new</span>
        </p>
      </a>

      <!-- Address - Pequeña -->
      <div class="animate-card card-shimmer bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-6 rounded-2xl border border-gray-200 dark:border-gray-600 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 bg-blue-50 dark:bg-blue-900/30 rounded-full flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
            <span class="material-icons text-blue-600 dark:text-blue-400 text-xl">location_on</span>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            {contact.address}
          </h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm">
          {contact.addressValue}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Toast notification -->
<div id="copy-toast" class="fixed bottom-6 right-6 bg-green-600 text-white px-6 py-3 rounded-lg shadow-2xl flex items-center gap-3 transform translate-y-32 opacity-0 transition-all duration-300" style="z-index: 99999;">
  <span class="material-icons">check_circle</span>
  <span id="copy-toast-text">Email copiado al portapapeles</span>
</div>

<script>
  function initEmailCopy() {
    const emailBtn = document.getElementById('email-copy-btn');
    const toast = document.getElementById('copy-toast');
    const toastText = document.getElementById('copy-toast-text');
    
    if (!emailBtn || !toast || !toastText) return;
    
    emailBtn.addEventListener('click', async () => {
      const email = emailBtn.getAttribute('data-email');
      if (!email) return;
      
      try {
        await navigator.clipboard.writeText(email);
        
        // Idioma actual desde la ruta i18n (Astro fija <html lang>)
        const currentLang = document.documentElement.lang || 'es';
        
        // Actualizar texto del toast según idioma
        toastText.textContent = currentLang === 'es' 
          ? 'Email copiado al portapapeles' 
          : 'Email copied to clipboard';
        
        // Mostrar toast
        toast.classList.remove('translate-y-32', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        
        // Ocultar después de 3 segundos
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-32', 'opacity-0');
        }, 3000);
      } catch (err) {
        console.error('Error al copiar:', err);
        
        // Fallback: seleccionar texto
        const tempInput = document.createElement('input');
        tempInput.value = email;
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);
        
        // Mostrar toast de todas formas
        const currentLang = document.documentElement.lang || 'es';
        toastText.textContent = currentLang === 'es' 
          ? 'Email copiado al portapapeles' 
          : 'Email copied to clipboard';
        toast.classList.remove('translate-y-32', 'opacity-0');
        toast.classList.add('translate-y-0', 'opacity-100');
        setTimeout(() => {
          toast.classList.remove('translate-y-0', 'opacity-100');
          toast.classList.add('translate-y-32', 'opacity-0');
        }, 3000);
      }
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initEmailCopy);
  } else {
    initEmailCopy();
  }
  
  document.addEventListener('astro:after-swap', initEmailCopy);
</script>
