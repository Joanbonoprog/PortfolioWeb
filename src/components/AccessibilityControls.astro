---
// Componente de controles de accesibilidad
---

<div id="accessibility-controls" class="fixed bottom-6 right-6 z-50">
  <!-- Botón flotante para abrir/cerrar -->
  <button
    id="accessibility-toggle"
    class="btn-ripple w-12 h-12 bg-blue-600 dark:bg-gray-800 text-white dark:text-gray-300 rounded-full shadow-lg hover:bg-blue-700 dark:hover:bg-gray-700 transition-all hover:scale-110 flex items-center justify-center"
    aria-label="Controles de accesibilidad"
  >
    <span class="material-icons">settings_accessibility</span>
  </button>

  <!-- Panel de controles -->
  <div
    id="accessibility-panel"
    class="absolute bottom-16 right-0 bg-white dark:bg-gray-800 rounded-xl shadow-2xl p-6 w-80 hidden transition-all duration-300 border border-gray-200 dark:border-gray-700"
  >
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-6 text-center" data-i18n-content="Accesibilidad">
      Accesibilidad
    </h3>

    <!-- Control de tamaño de fuente -->
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 text-center" data-i18n-content="Tamaño de texto">
        Tamaño de texto
      </label>
      <div class="grid grid-cols-3 gap-3">
        <button
          data-font-size="normal"
          class="px-4 py-3 text-sm font-medium border-2 border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all hover:scale-105"
          data-i18n-content="Normal"
        >
          Normal
        </button>
        <button
          data-font-size="large"
          class="px-4 py-3 text-sm font-medium border-2 border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all hover:scale-105"
          data-i18n-content="Grande"
        >
          Grande
        </button>
        <button
          data-font-size="extra-large"
          class="px-4 py-3 text-sm font-medium border-2 border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-700 transition-all hover:scale-105"
          data-i18n-content="Muy Grande"
        >
          Muy Grande
        </button>
      </div>
    </div>

    <!-- Información -->
    <p class="text-xs text-gray-500 dark:text-gray-400 text-center leading-relaxed" data-i18n-content="Usa estos controles para mejorar tu experiencia de lectura">
      Usa estos controles para mejorar tu experiencia de lectura
    </p>
  </div>
</div>

<script>
  // Toggle del panel
  const toggle = document.getElementById('accessibility-toggle');
  const panel = document.getElementById('accessibility-panel');

  toggle?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    const controls = document.getElementById('accessibility-controls');
    if (controls && !controls.contains(e.target as Node)) {
      panel?.classList.add('hidden');
    }
  });
</script>

<style>
  /* Estilo para botón activo */
  [data-font-size].active {
    background-color: rgb(59, 130, 246);
    color: white;
    border-color: rgb(59, 130, 246);
    font-weight: 600;
    transform: scale(1.05);
  }

  .dark [data-font-size].active {
    background-color: rgb(96, 165, 250);
    border-color: rgb(96, 165, 250);
    color: rgb(17, 24, 39);
  }
  
  [data-font-size]:hover {
    transform: scale(1.05);
  }
</style>
