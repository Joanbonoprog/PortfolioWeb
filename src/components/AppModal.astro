---
// Modal para mostrar detalles de proyectos y experiencias
interface Props {
  translations: any;
}

const { translations } = Astro.props;
---

<!-- Modal Overlay -->
<div id="app-modal" class="modal-overlay fixed inset-0 bg-black/50 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <!-- Modal Content -->
  <div class="modal-content bg-white rounded-3xl shadow-2xl max-w-2xl w-full max-h-[90vh] overflow-hidden transform scale-95 opacity-0 transition-all duration-300">
    <!-- Modal Header -->
    <div class="modal-header bg-gradient-to-r from-blue-600 to-purple-600 px-6 py-4 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div id="modal-icon" class="w-12 h-12 bg-white rounded-xl flex items-center justify-center text-2xl shadow-lg">
          📱
        </div>
        <div>
          <h3 id="modal-title" class="text-white text-xl font-bold">
            App Title
          </h3>
          <p id="modal-subtitle" class="text-white/80 text-sm">
            Subtitle
          </p>
        </div>
      </div>
      <button id="close-modal" class="w-10 h-10 bg-white/20 rounded-full flex items-center justify-center hover:bg-white/30 transition-colors">
        <span class="material-icons text-white">close</span>
      </button>
    </div>

    <!-- Modal Body -->
    <div class="modal-body p-6 overflow-y-auto max-h-[calc(90vh-200px)]">
      <!-- Description -->
      <div class="mb-6">
        <h4 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
          <span class="material-icons text-blue-600">description</span>
          <span id="description-label" data-i18n-content="Descripción">Descripción</span>
        </h4>
        <p id="modal-description" class="text-gray-700 leading-relaxed">
          Description text will appear here...
        </p>
      </div>

      <!-- Technologies (for projects) -->
      <div id="tech-section" class="mb-6 hidden">
        <h4 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
          <span class="material-icons text-blue-600">code</span>
          <span id="tech-label" data-i18n-content="Tecnologías">Tecnologías</span>
        </h4>
        <div id="tech-list" class="flex flex-wrap gap-2">
          <!-- Tech badges will be inserted here -->
        </div>
      </div>

      <!-- Period (for experience) -->
      <div id="period-section" class="mb-6 hidden">
        <h4 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
          <span class="material-icons text-blue-600">calendar_today</span>
          <span id="period-label" data-i18n-content="Período">Período</span>
        </h4>
        <p id="modal-period" class="text-gray-700">
          Period will appear here...
        </p>
      </div>

      <!-- Company (for experience) -->
      <div id="company-section" class="mb-6 hidden">
        <h4 class="text-lg font-semibold text-gray-900 mb-3 flex items-center gap-2">
          <span class="material-icons text-blue-600">business</span>
          <span id="company-label" data-i18n-content="Empresa">Empresa</span>
        </h4>
        <p id="modal-company" class="text-gray-700">
          Company will appear here...
        </p>
      </div>

      <!-- GitHub Link (for projects) -->
      <div id="github-section" class="hidden">
        <a id="github-link" href="#" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-full hover:bg-gray-800 transition-colors">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
          <span id="github-text" data-i18n-content="Ver en GitHub">Ver en GitHub</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .modal-overlay.show {
    display: flex !important;
  }

  .modal-overlay.show .modal-content {
    transform: scale(1);
    opacity: 1;
  }

  .modal-body::-webkit-scrollbar {
    width: 8px;
  }

  .modal-body::-webkit-scrollbar-track {
    background: #f1f1f1;
    border-radius: 10px;
  }

  .modal-body::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 10px;
  }

  .modal-body::-webkit-scrollbar-thumb:hover {
    background: #555;
  }
</style>

<script>
  // Gestión del modal
  const modal = document.getElementById('app-modal');
  const closeBtn = document.getElementById('close-modal');

  // Elementos del modal
  const modalIcon = document.getElementById('modal-icon');
  const modalTitle = document.getElementById('modal-title');
  const modalSubtitle = document.getElementById('modal-subtitle');
  const modalDescription = document.getElementById('modal-description');
  const techSection = document.getElementById('tech-section');
  const techList = document.getElementById('tech-list');
  const periodSection = document.getElementById('period-section');
  const modalPeriod = document.getElementById('modal-period');
  const companySection = document.getElementById('company-section');
  const modalCompany = document.getElementById('modal-company');
  const githubSection = document.getElementById('github-section');
  const githubLink = document.getElementById('github-link') as HTMLAnchorElement;

  // Función para abrir el modal
  function openModal(appData: any, type: string) {
    if (!modal || !modalIcon || !modalTitle || !modalSubtitle || !modalDescription) return;

    // Resetear secciones
    techSection?.classList.add('hidden');
    periodSection?.classList.add('hidden');
    companySection?.classList.add('hidden');
    githubSection?.classList.add('hidden');

    // Configurar contenido común
    modalIcon.textContent = appData.icon;
    modalDescription.textContent = appData.description;

    if (type === 'project') {
      // Configurar para proyecto
      modalTitle.textContent = appData.name;
      modalSubtitle.textContent = appData.subtitle;

      // Mostrar tecnologías
      if (appData.tech && techList) {
        techSection?.classList.remove('hidden');
        techList.innerHTML = appData.tech.map((tech: string) => 
          `<span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-sm font-medium">${tech}</span>`
        ).join('');
      }

      // Mostrar enlace de GitHub
      if (appData.github && githubLink) {
        githubSection?.classList.remove('hidden');
        githubLink.href = appData.github;
      }
    } else {
      // Configurar para experiencia
      modalTitle.textContent = appData.role;
      modalSubtitle.textContent = appData.company;

      // Mostrar período
      if (appData.period && modalPeriod) {
        periodSection?.classList.remove('hidden');
        modalPeriod.textContent = appData.period;
      }

      // Mostrar empresa
      if (appData.company && modalCompany) {
        companySection?.classList.remove('hidden');
        modalCompany.textContent = appData.company;
      }
    }

    // Mostrar modal con animación
    modal.classList.remove('hidden');
    modal.classList.add('show');
    document.body.style.overflow = 'hidden';
    
    // Aplicar traducciones después de mostrar el modal
    setTimeout(() => {
      if (typeof window.applyTranslations === 'function') {
        window.applyTranslations();
      }
    }, 100);
  }

  // Función para cerrar el modal
  function closeModal() {
    if (!modal) return;
    
    modal.classList.remove('show');
    setTimeout(() => {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  // Event listeners
  closeBtn?.addEventListener('click', closeModal);
  
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Escuchar evento personalizado desde PhoneSimulator
  window.addEventListener('openAppModal', ((e: CustomEvent) => {
    openModal(e.detail.app, e.detail.type);
  }) as EventListener);

  // Cerrar con tecla ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeModal();
    }
  });
</script>
