---
import Image from 'astro/components/Image.astro';
import { getImage } from 'astro:assets';

interface Props {
  translations: any;
}

const { translations } = Astro.props;
const { skills } = translations;

// Mapeo de tecnologías con sus logos
// IMPORTANTE: JavaScript debe ir antes que Java para evitar conflictos
const techLogos: Record<string, string> = {
  'IAs Generativas': '/images/skills/openai.svg',
  'chatbots': '/images/skills/telegram.svg',
  'JavaScript': '/images/skills/javascript-original.svg',
  'Java': '/images/skills/java-original.svg',
  'C#': '/images/skills/csharp-original.svg',
  'mySQL': '/images/skills/mysql-original.svg',
  'PHP': '/images/skills/php-original.svg',
  'Android': '/images/skills/android-original.svg',
  'Unity': '/images/skills/unity-original.svg',
  'n8n': '/images/skills/n8n.svg',
  'Docker': '/images/skills/docker-original.svg',
  'Git': '/images/skills/git-original.svg'
};

function getTechLogo(skill: string): string {
  const skillLower = skill.toLowerCase();
  
  // Luego buscar en el mapeo
  for (const [tech, logo] of Object.entries(techLogos)) {
    if (skillLower.includes(tech.toLowerCase())) {
      return logo;
    }
  }
  return '💻'; // Logo por defecto
}
---

<section id="skills" class="py-20 px-6 transition-colors duration-300">
  <div class="max-w-6xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 text-center" data-i18n="skills.title">
      {skills.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto" data-i18n="skills.subtitle">
      {skills.subtitle}
    </p>

    <!-- Skills Slider -->
    <div class="flex items-center gap-2 md:gap-4">
      <!-- Botón Anterior -->
      <button id="skills-prev" class="btn-ripple flex-shrink-0 hidden md:flex bg-white dark:bg-gray-800 text-gray-900 dark:text-white p-2 md:p-3 rounded-full shadow-lg hover:shadow-xl hover:scale-110 active:scale-95 transition-all duration-300 border-2 border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400">
        <span class="material-icons text-xl md:text-2xl">chevron_left</span>
      </button>
      
      <!-- Contenedor del slider -->
      <div class="flex-1 overflow-hidden min-h-[300px] md:min-h-[400px] flex items-start">
        <div id="skills-slider" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6 transition-opacity duration-500 ease-out opacity-0 w-full auto-rows-max">
          {skills.items.map((skill: any, index: number) => {
            const skillName = typeof skill === 'string' ? skill : skill.name;
            const skillLevel = typeof skill === 'string' ? 70 : skill.level;
            const skillLevelName = typeof skill === 'string' ? 'Intermedio' : skill.levelName;
            
            return (
              <div 
                class="card-shimmer bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-6 rounded-xl border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group"
              >
                <div class="flex items-start gap-4 mb-3">
                  <div class="flex-shrink-0 w-12 h-12 bg-blue-50 dark:bg-blue-900/30 rounded-lg flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
                    {getTechLogo(skillName).startsWith('http') || getTechLogo(skillName).startsWith('/') ? (
                      <img src={getTechLogo(skillName)} alt="" loading="lazy" class="w-8 h-8 object-contain" />
                    ) : (
                      <span class="text-2xl">{getTechLogo(skillName)}</span>
                    )}
                  </div>
                  <div class="flex-1">
                    <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-2" data-i18n-content={skillName}>
                      {skillName}
                    </p>
                    <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden mb-1">
                      <div 
                        class="h-full bg-gradient-to-r from-blue-600 to-blue-400 dark:from-blue-500 dark:to-blue-300 rounded-full transition-all duration-1000 skill-progress"
                        style={`width: 0%;`}
                        data-level={skillLevel}
                      ></div>
                    </div>
                    <span class="text-xs font-medium text-blue-700 dark:text-blue-300" data-i18n-content={skillLevelName}>{skillLevelName}</span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
      
      <!-- Botón Siguiente -->
      <button id="skills-next" class="btn-ripple flex-shrink-0 hidden md:flex bg-white dark:bg-gray-800 text-gray-900 dark:text-white p-2 md:p-3 rounded-full shadow-lg hover:shadow-xl hover:scale-110 active:scale-95 transition-all duration-300 border-2 border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400">
        <span class="material-icons text-xl md:text-2xl">chevron_right</span>
      </button>
    </div>

    <!-- Indicadores de página -->
    <div id="skills-indicators" class="flex justify-center gap-2 mt-6 md:mt-8">
      <!-- Los indicadores se generarán dinámicamente -->
    </div>
    
    <!-- Hint de gestos para móviles -->
    <div id="skills-swipe-hint" class="md:hidden text-center mt-4 text-sm text-gray-500 dark:text-gray-400 flex items-center justify-center gap-2 opacity-70">
      <span class="material-icons text-base">swipe</span>
      <span>Desliza para navegar</span>
    </div>
  </div>
</section>

<script>
  // Animar las barras de progreso cuando entran en viewport
  function initSkillBars(retries = 0) {
    const progressBars = document.querySelectorAll('.skill-progress');
    
    if (progressBars.length === 0) {
      if (retries < 20) setTimeout(() => initSkillBars(retries + 1), 100);
      return;
    }
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const bar = entry.target as HTMLElement;
          const level = bar.getAttribute('data-level');
          if (level) {
            setTimeout(() => {
              bar.style.width = `${level}%`;
            }, 100);
            observer.unobserve(bar);
          }
        }
      });
    }, { threshold: 0.1 });
    
    progressBars.forEach(bar => observer.observe(bar));
  }
  
  // Inicializar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initSkillBars());
  } else {
    initSkillBars();
  }
  
  // También reinicializar después de cambios de idioma
  document.addEventListener('astro:after-swap', () => initSkillBars());

  // Control del slider de skills
  function initSkillsSlider() {
    const slider = document.getElementById('skills-slider');
    const prevBtn = document.getElementById('skills-prev');
    const nextBtn = document.getElementById('skills-next');
    const indicatorsContainer = document.getElementById('skills-indicators');
    
    if (!slider || !prevBtn || !nextBtn) return;
    
    const items = slider.children;
    // Calcular items por página según el ancho de pantalla
    let itemsPerPage = 9; // 3 columnas x 3 filas en desktop
    if (window.innerWidth < 1024) {
      itemsPerPage = 6; // 2 columnas x 3 filas en tablet
    }
    if (window.innerWidth < 768) {
      itemsPerPage = 3; // 1 columna x 3 filas en móvil
    }
    const totalPages = Math.ceil(items.length / itemsPerPage);
    let currentPage = 0;
    
    // Crear indicadores
    if (indicatorsContainer) {
      indicatorsContainer.innerHTML = '';
      for (let i = 0; i < totalPages; i++) {
        const indicator = document.createElement('button');
        indicator.className = `h-2 rounded-full transition-all duration-300 hover:scale-110 ${i === 0 ? 'bg-blue-600 dark:bg-blue-400 w-8' : 'bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500 w-2'}`;
        indicator.addEventListener('click', () => goToPage(i));
        indicatorsContainer.appendChild(indicator);
      }
    }
    
    function updateSlider() {
      if (!slider) return;
      
      // Fade out
      slider.style.opacity = '0';
      
      setTimeout(() => {
        // Ocultar/mostrar items según la página actual
        Array.from(items).forEach((item, index) => {
          const startIndex = currentPage * itemsPerPage;
          const endIndex = startIndex + itemsPerPage;
          const htmlItem = item as HTMLElement;
          
          if (index >= startIndex && index < endIndex) {
            htmlItem.style.display = '';
          } else {
            htmlItem.style.display = 'none';
          }
        });
        
        // Fade in
        if (slider) slider.style.opacity = '1';
      }, 300);
      
      // Actualizar indicadores
      if (indicatorsContainer) {
        Array.from(indicatorsContainer.children).forEach((indicator, index) => {
          if (index === currentPage) {
            indicator.className = 'h-2 rounded-full transition-all duration-300 hover:scale-110 bg-blue-600 dark:bg-blue-400 w-8';
          } else {
            indicator.className = 'h-2 rounded-full transition-all duration-300 hover:scale-110 bg-gray-300 dark:bg-gray-600 hover:bg-gray-400 dark:hover:bg-gray-500 w-2';
          }
        });
      }
      
      // Actualizar botones
      if (prevBtn) {
        if (currentPage === 0) {
          prevBtn.style.opacity = '0.3';
          prevBtn.style.pointerEvents = 'none';
          prevBtn.style.cursor = 'not-allowed';
          prevBtn.classList.add('grayscale');
        } else {
          prevBtn.style.opacity = '1';
          prevBtn.style.pointerEvents = 'auto';
          prevBtn.style.cursor = 'pointer';
          prevBtn.classList.remove('grayscale');
        }
      }
      if (nextBtn) {
        if (currentPage === totalPages - 1) {
          nextBtn.style.opacity = '0.3';
          nextBtn.style.pointerEvents = 'none';
          nextBtn.style.cursor = 'not-allowed';
          nextBtn.classList.add('grayscale');
        } else {
          nextBtn.style.opacity = '1';
          nextBtn.style.pointerEvents = 'auto';
          nextBtn.style.cursor = 'pointer';
          nextBtn.classList.remove('grayscale');
        }
      }
    }
    
    function goToPage(page: number) {
      currentPage = Math.max(0, Math.min(page, totalPages - 1));
      updateSlider();
    }
    
    prevBtn.addEventListener('click', () => goToPage(currentPage - 1));
    nextBtn.addEventListener('click', () => goToPage(currentPage + 1));
    
    // Soporte para gestos táctiles
    let touchStartX = 0;
    let touchEndX = 0;
    
    slider.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });
    
    slider.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      handleSwipe();
    }, { passive: true });
    
    function handleSwipe() {
      const swipeThreshold = 50;
      const diff = touchStartX - touchEndX;
      
      if (Math.abs(diff) > swipeThreshold) {
        if (diff > 0) {
          goToPage(currentPage + 1); // Swipe izquierda
        } else {
          goToPage(currentPage - 1); // Swipe derecha
        }
      }
    }
    
    // Actualizar al cambiar tamaño de ventana
    window.addEventListener('resize', () => {
      currentPage = 0;
      updateSlider();
    });
    
    updateSlider();
    
    // Mostrar el slider con animación inicial
    setTimeout(() => {
      if (slider) slider.style.opacity = '1';
    }, 100);
    
    // Ocultar hint de gestos después de 3 segundos en móviles
    const swipeHint = document.getElementById('skills-swipe-hint');
    if (swipeHint && window.innerWidth < 768) {
      setTimeout(() => {
        swipeHint.style.transition = 'opacity 0.5s ease';
        swipeHint.style.opacity = '0';
        setTimeout(() => {
          swipeHint.style.display = 'none';
        }, 500);
      }, 3000);
    }
  }
  
  // Inicializar slider
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSkillsSlider);
  } else {
    initSkillsSlider();
  }
  
  document.addEventListener('astro:after-swap', initSkillsSlider);
</script>
