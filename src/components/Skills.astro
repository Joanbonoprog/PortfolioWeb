---
import Image from 'astro/components/Image.astro';
import { getImage } from 'astro:assets';

interface Props {
  translations: any;
}

const { translations } = Astro.props;
const { skills } = translations;

// Mapeo de tecnologías con sus logos
// IMPORTANTE: JavaScript debe ir antes que Java para evitar conflictos
const techLogos: Record<string, string> = {
  'IAs Generativas': '/openai.svg',
  'chatbots': '/telegram.svg',
  'JavaScript': '/javascript-original.svg',
  'Java': '/java-original.svg',
  'C#': '/csharp-original.svg',
  'mySQL': '/mysql-original.svg',
  'PHP': '/php-original.svg',
  'Android': '/android-original.svg',
  'Unity': '/unity-original.svg',
  'n8n': '/n8n.svg',
  'Docker': '/docker-original.svg',
  'Git': '/git-original.svg'
};

function getTechLogo(skill: string): string {
  const skillLower = skill.toLowerCase();
  
  // Luego buscar en el mapeo
  for (const [tech, logo] of Object.entries(techLogos)) {
    if (skillLower.includes(tech.toLowerCase())) {
      return logo;
    }
  }
  return '💻'; // Logo por defecto
}
---

<section id="skills" class="py-20 px-6 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 mb-12 text-center" data-i18n="skills.title">
      {skills.title}
    </h2>

    <!-- Skills Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {skills.items.map((skill: string, index: number) => (
        <div 
          class="bg-white p-6 rounded-xl border border-gray-200 hover:border-blue-400 hover:shadow-lg transition-all group"
          style={`animation-delay: ${index * 0.1}s;`}
        >
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 bg-blue-50 rounded-lg flex items-center justify-center group-hover:bg-blue-100 transition-colors">
              {getTechLogo(skill).startsWith('http') || getTechLogo(skill).startsWith('/') ? (
                <img src={getTechLogo(skill)} alt="" class="w-8 h-8 object-contain" />
              ) : (
                <span class="text-2xl">{getTechLogo(skill)}</span>
              )}
            </div>
            <p class="text-gray-700 leading-relaxed flex-1" data-i18n-content={skill}>
              {skill}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
