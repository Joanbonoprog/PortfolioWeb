---
import Image from 'astro/components/Image.astro';
import { getImage } from 'astro:assets';

interface Props {
  translations: any;
}

const { translations } = Astro.props;
const { skills } = translations;

// Mapeo de tecnologías con sus logos
// IMPORTANTE: JavaScript debe ir antes que Java para evitar conflictos
const techLogos: Record<string, string> = {
  'IAs Generativas': '/openai.svg',
  'chatbots': '/telegram.svg',
  'JavaScript': '/javascript-original.svg',
  'Java': '/java-original.svg',
  'C#': '/csharp-original.svg',
  'mySQL': '/mysql-original.svg',
  'PHP': '/php-original.svg',
  'Android': '/android-original.svg',
  'Unity': '/unity-original.svg',
  'n8n': '/n8n.svg',
  'Docker': '/docker-original.svg',
  'Git': '/git-original.svg'
};

function getTechLogo(skill: string): string {
  const skillLower = skill.toLowerCase();
  
  // Luego buscar en el mapeo
  for (const [tech, logo] of Object.entries(techLogos)) {
    if (skillLower.includes(tech.toLowerCase())) {
      return logo;
    }
  }
  return '💻'; // Logo por defecto
}
---

<section id="skills" class="py-20 px-6 transition-colors duration-300">
  <div class="max-w-6xl mx-auto">
    <!-- Title -->
    <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 text-center" data-i18n="skills.title">
      {skills.title}
    </h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto" data-i18n="skills.subtitle">
      {skills.subtitle}
    </p>

    <!-- Skills Grid -->
    <div class="grid md:grid-cols-2 gap-6">
      {skills.items.map((skill: any, index: number) => {
        const skillName = typeof skill === 'string' ? skill : skill.name;
        const skillLevel = typeof skill === 'string' ? 70 : skill.level;
        const skillLevelName = typeof skill === 'string' ? 'Intermedio' : skill.levelName;
        
        return (
          <div 
            class="animate-card card-shimmer bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md p-6 rounded-xl border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group"
            style={`transition-delay: ${index * 0.05}s;`}
          >
            <div class="flex items-start gap-4 mb-3">
              <div class="flex-shrink-0 w-12 h-12 bg-blue-50 dark:bg-blue-900/30 rounded-lg flex items-center justify-center group-hover:bg-blue-100 dark:group-hover:bg-blue-800/40 transition-colors">
                {getTechLogo(skillName).startsWith('http') || getTechLogo(skillName).startsWith('/') ? (
                  <img src={getTechLogo(skillName)} alt="" loading="lazy" class="w-8 h-8 object-contain" />
                ) : (
                  <span class="text-2xl">{getTechLogo(skillName)}</span>
                )}
              </div>
              <div class="flex-1">
                <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-2" data-i18n-content={skillName}>
                  {skillName}
                </p>
                <div class="w-full bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden mb-1">
                  <div 
                    class="h-full bg-gradient-to-r from-blue-600 to-blue-400 dark:from-blue-500 dark:to-blue-300 rounded-full transition-all duration-1000 skill-progress"
                    style={`width: 0%;`}
                    data-level={skillLevel}
                  ></div>
                </div>
                <span class="text-xs font-medium text-blue-700 dark:text-blue-300" data-i18n-content={skillLevelName}>{skillLevelName}</span>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<script>
  // Animar las barras de progreso cuando entran en viewport
  const progressBars = document.querySelectorAll('.skill-progress');
  
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const bar = entry.target as HTMLElement;
        const level = bar.getAttribute('data-level');
        setTimeout(() => {
          bar.style.width = `${level}%`;
        }, 100);
        observer.unobserve(bar);
      }
    });
  }, { threshold: 0.1 });
  
  progressBars.forEach(bar => observer.observe(bar));
</script>
