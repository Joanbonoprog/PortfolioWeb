---
// Componente de controles de accesibilidad
import type { Translations } from '../../types/translations';
import FontSizeButton from '../ui/FontSizeButton.astro';
import AccessibilityToggle from '../ui/AccessibilityToggle.astro';
import AccessibilityPanel from '../ui/AccessibilityPanel.astro';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
const { accessibility } = translations;
---

<div id="accessibility-controls" class="fixed bottom-6 right-6 z-50">
  <!-- Botón flotante para abrir/cerrar -->
  <AccessibilityToggle ariaLabel={accessibility.title} />

  <!-- Panel de controles -->
  <AccessibilityPanel title={accessibility.title}>
    <!-- Control de tamaño de fuente -->
    <div class="mb-6">
      <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-3 text-center">
        {accessibility.textSize}
      </label>
      <div class="grid grid-cols-3 gap-3">
        <FontSizeButton fontSize="normal">
          {accessibility.normal}
        </FontSizeButton>
        <FontSizeButton fontSize="large">
          {accessibility.large}
        </FontSizeButton>
        <FontSizeButton fontSize="extra-large">
          {accessibility.extraLarge}
        </FontSizeButton>
      </div>
    </div>

    <!-- Información -->
    <p class="text-xs text-gray-500 dark:text-gray-400 text-center leading-relaxed">
      {accessibility.hint}
    </p>
  </AccessibilityPanel>
</div>

<script>
  // Toggle del panel
  const toggle = document.getElementById('accessibility-toggle');
  const panel = document.getElementById('accessibility-panel');

  toggle?.addEventListener('click', () => {
    panel?.classList.toggle('hidden');
  });

  // Cerrar al hacer clic fuera
  document.addEventListener('click', (e) => {
    const controls = document.getElementById('accessibility-controls');
    if (controls && !controls.contains(e.target as Node)) {
      panel?.classList.add('hidden');
    }
  });
</script>

<style>
  /* Estilo para botón activo */
  [data-font-size].active {
    background-color: rgb(59, 130, 246);
    color: white;
    border-color: rgb(59, 130, 246);
    font-weight: 600;
    transform: scale(1.05);
  }

  .dark [data-font-size].active {
    background-color: rgb(96, 165, 250);
    border-color: rgb(96, 165, 250);
    color: rgb(17, 24, 39);
  }
  
  [data-font-size]:hover {
    transform: scale(1.05);
  }
</style>
