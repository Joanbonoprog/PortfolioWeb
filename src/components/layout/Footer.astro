---
import type { Translations } from '../../types/translations';
import TechLogo from '../ui/TechLogo.astro';
import Divider from '../ui/Divider.astro';

interface Props {
  translations: Translations;
}

const { translations } = Astro.props;
const { footer } = translations;
---

<footer class="bg-white/70 dark:bg-gray-900/70 backdrop-blur-sm text-gray-900 dark:text-white py-12 px-6 transition-colors duration-300">
  <div class="max-w-6xl mx-auto text-center">
    <!-- Tech Stack Section -->
    <h3 class="text-gray-600 dark:text-gray-400 text-sm font-semibold uppercase tracking-wider mb-6">
      {footer.builtWith}
    </h3>
    <div class="flex flex-wrap items-center justify-center gap-8 mb-8">
      {footer.techStack.map((tech) => (
        <TechLogo
          name={tech.name}
          logo={tech.logo}
          logoDark={tech.logoDark}
          url={tech.url}
        />
      ))}
    </div>

    <!-- Divider -->
    <Divider />

    <!-- Copyright -->
    <p class="text-gray-600 dark:text-gray-400 text-sm mb-2">
      © {new Date().getFullYear()} {translations.meta.author}. {footer.footerRole}
    </p>
  </div>
</footer>
