---
interface Props {
  currentLang: string;
  esUrl: string;
  enUrl: string;
  ariaLabel?: string;
}

const { currentLang, esUrl, enUrl, ariaLabel } = Astro.props;
---

<div id="lang-dropdown" class="relative">
  <button
    id="lang-dropdown-btn"
    class="flex items-center gap-1.5 px-2 sm:px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-700 dark:text-gray-300 font-medium cursor-pointer hover:border-blue-500 dark:hover:border-blue-400 focus:outline-none focus:ring-2 focus:ring-blue-500 transition-all text-sm"
    aria-label={ariaLabel}
    aria-haspopup="listbox"
    aria-expanded="false"
  >
    <span id="lang-flag" class={`fi fi-${currentLang === 'en' ? 'gb' : 'es'} rounded-sm`}></span>
    <span id="lang-label">{currentLang.toUpperCase()}</span>
    <span class="material-icons text-base leading-none">expand_more</span>
  </button>
  <ul
    id="lang-menu"
    role="listbox"
    class="hidden absolute right-0 mt-1 w-28 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-lg overflow-hidden z-50"
  >
    <li
      role="option"
      data-lang="es"
      data-href={esUrl}
      aria-selected={currentLang === 'es' ? 'true' : 'false'}
      class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-blue-50 dark:hover:bg-blue-900/30 text-gray-700 dark:text-gray-300 text-sm font-medium transition-colors"
    >
      <span class="fi fi-es rounded-sm"></span> ES
    </li>
    <li
      role="option"
      data-lang="en"
      data-href={enUrl}
      aria-selected={currentLang === 'en' ? 'true' : 'false'}
      class="flex items-center gap-2 px-3 py-2 cursor-pointer hover:bg-blue-50 dark:hover:bg-blue-900/30 text-gray-700 dark:text-gray-300 text-sm font-medium transition-colors"
    >
      <span class="fi fi-gb rounded-sm"></span> EN
    </li>
  </ul>
</div>
