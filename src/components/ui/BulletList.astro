---
interface Props {
  items: string[];
  separator?: string;
  bulletColor?: 'blue' | 'gray' | 'green';
  className?: string;
}

const { 
  items, 
  separator = '.', 
  bulletColor = 'blue',
  className = ''
} = Astro.props;

const bulletColorClasses = {
  blue: 'text-blue-600 dark:text-blue-400',
  gray: 'text-gray-600 dark:text-gray-400',
  green: 'text-green-600 dark:text-green-400'
};

const processedItems = separator 
  ? items.join(separator).split(separator).filter((item: string) => item.trim())
  : items;
---

<ul class={`space-y-2 ${className}`}>
  {processedItems.map((item: string) => (
    <li class="text-gray-700 dark:text-gray-300 leading-relaxed flex items-start gap-2">
      <span class={`${bulletColorClasses[bulletColor]} leading-relaxed`}>•</span>
      <span class="flex-1">{item.trim()}{item.trim().endsWith('.') ? '' : '.'}</span>
    </li>
  ))}
</ul>
