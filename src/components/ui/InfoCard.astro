---
interface Props {
  colSpan?: '1' | '2' | '3';
  rowSpan?: '1' | '2';
  padding?: 'sm' | 'md' | 'lg';
  className?: string;
}

const { 
  colSpan = '1', 
  rowSpan = '1',
  padding = 'md',
  className = ''
} = Astro.props;

const paddingClasses = {
  sm: 'p-4',
  md: 'p-6',
  lg: 'p-8'
};

const colSpanClasses = {
  '1': '',
  '2': 'md:col-span-2',
  '3': 'md:col-span-3'
};

const rowSpanClasses = {
  '1': '',
  '2': 'md:row-span-2'
};
---

<div class={`animate-card card-shimmer bg-gray-50/50 dark:bg-gray-800/80 backdrop-blur-md ${paddingClasses[padding]} rounded-2xl border border-gray-200 dark:border-gray-600 shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group ${colSpanClasses[colSpan]} ${rowSpanClasses[rowSpan]} ${className}`}>
  <slot />
</div>
