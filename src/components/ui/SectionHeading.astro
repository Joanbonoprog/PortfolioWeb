---
interface Props {
  icon: string;
  title: string;
  subtitle: string;
}

const { icon, title, subtitle } = Astro.props;
---

<div class="text-center mb-12">
  <h2 class="text-4xl md:text-5xl font-bold text-gray-900 dark:text-white mb-4 flex items-center justify-center gap-2">
    <span class="material-icons text-5xl text-blue-600 dark:text-blue-400 align-middle">{icon}</span>
    <span>{title}</span>
  </h2>
  <p class="text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
    {subtitle}
  </p>
</div>
