---
interface Props {
  id?: string;
  icon?: string;
  variant?: 'primary' | 'gradient' | 'secondary';
  rounded?: 'lg' | 'full';
  size?: 'md' | 'lg';
  className?: string;
}

const { 
  id, 
  icon, 
  variant = 'primary', 
  rounded = 'lg',
  size = 'lg',
  className = ''
} = Astro.props;

const sizeClasses = {
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg'
};

const variantClasses = {
  primary: 'bg-blue-600 hover:bg-blue-700 text-white',
  gradient: 'bg-gradient-to-r from-blue-600 to-blue-500 hover:from-blue-700 hover:to-blue-600 text-white border border-blue-400/30',
  secondary: 'bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white hover:bg-gray-200 dark:hover:bg-gray-700'
};

const roundedClasses = {
  lg: 'rounded-lg',
  full: 'rounded-full'
};
---

<button
  id={id}
  class={`btn-ripple flex items-center gap-3 ${sizeClasses[size]} ${variantClasses[variant]} ${roundedClasses[rounded]} font-semibold shadow-lg hover:shadow-xl hover:shadow-blue-500/30 hover:scale-105 active:scale-95 transition-all duration-300 ${className}`}
>
  {icon && <span class="material-icons">{icon}</span>}
  <span><slot /></span>
</button>
