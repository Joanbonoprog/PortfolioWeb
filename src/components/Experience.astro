---
interface Props {
  translations: any;
}

const { translations } = Astro.props;
const { experience } = translations;
---

<section id="experience" class="py-20 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-4xl font-bold text-gray-900 dark:text-white mb-4 text-center">
      <span class="material-icons text-5xl text-blue-600 dark:text-blue-400 align-middle mr-2">work</span>
      <span data-i18n="experience.title" data-i18n-content={experience.title}>{experience.title}</span>
    </h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto" data-i18n="experience.subtitle">
      {experience.subtitle}
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      {experience.items.map((exp: any) => (
        <div class="bg-gradient-to-br from-blue-50/50 to-indigo-50/50 dark:from-gray-800/80 dark:to-gray-800/80 backdrop-blur-md rounded-2xl shadow-lg hover:shadow-2xl hover:shadow-gray-900/20 dark:hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 group">
          <div class="p-8">
            <!-- Header -->
            <div class="flex items-start gap-4 mb-6">
              {exp.icon.startsWith('/') ? (
                <div class="w-16 h-16 flex-shrink-0">
                  <img src={exp.icon} alt={exp.role} class="w-full h-full object-contain" />
                </div>
              ) : (
                <div class="text-5xl flex-shrink-0">{exp.icon}</div>
              )}
              <div class="flex-1">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors" data-i18n-content={exp.role}>
                  {exp.role}
                </h3>
                <p class="text-blue-600 dark:text-blue-400 font-medium mb-1" data-i18n-content={exp.company}>
                  {exp.company}
                </p>
                <p class="text-gray-600 dark:text-gray-400 text-sm flex items-center gap-1">
                  <span class="material-icons text-sm">calendar_today</span>
                  <span data-i18n-content={exp.period}>{exp.period}</span>
                </p>
              </div>
            </div>

            <!-- Description -->
            {exp.description.includes('|') ? (
              <ul class="space-y-3 mb-6">
                {exp.description.split('|').map((item: string) => (
                  <li class="text-gray-700 dark:text-gray-300 leading-relaxed flex items-start gap-2">
                    <span class="text-blue-600 dark:text-blue-400 mt-1">•</span>
                    <span class="flex-1" data-i18n-content={item.trim()}>{item.trim()}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-6" data-i18n-content={exp.description}>
                {exp.description}
              </p>
            )}

            <!-- Website Link -->
            {exp.website && (
              <a
                href={exp.website}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-all hover:scale-105 font-medium"
              >
                <span class="material-icons text-lg">language</span>
                <span data-i18n="experience.visitWebsite">{experience.visitWebsite}</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  section {
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
