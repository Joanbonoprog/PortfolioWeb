---
import '../styles/global.css';
import AccessibilityControls from '../components/AccessibilityControls.astro';
import { getTranslations } from '../i18n/index';
import type { Language } from '../i18n/index';

interface Props {
	title?: string;
	description?: string;
	lang?: string;
}

const { 
	title = 'Joan Bono Frigols - Portfolio', 
	description = 'Desarrollador de Software + IA Specialist',
	lang = 'es'
} = Astro.props;

const i18nEs = getTranslations('es');
const i18nEn = getTranslations('en');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/images/brand/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Preconnect for performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		
		<!-- Google Fonts - Inter (optimized) -->
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"></noscript>
		
		<!-- Material Icons (optimized) -->
		<link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript><link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet"></noscript>
		
		<!-- Flag Icons -->
		<link rel="preconnect" href="https://cdn.jsdelivr.net">
		<link href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css" rel="stylesheet">
		
		<title>{title}</title>
		<!-- Traducciones SSR embebidas — fuente de verdad única para el cliente -->
		<script is:inline define:vars={{ i18nEs, i18nEn }}>
			window.__i18n__ = { es: i18nEs, en: i18nEn };
		</script>
	</head>
	<body class="bg-gray-50 dark:bg-gray-900 text-gray-900 dark:text-gray-100 antialiased transition-colors duration-300">
		<!-- Scroll Progress Indicator -->
		<div id="scroll-progress" class="scroll-progress"></div>
		
		<!-- Fondo animado con ondas -->
		<div class="animated-background">
			<div class="wave"></div>
			<div class="wave"></div>
			<div class="wave"></div>
		</div>
		
		<slot />
		
		<!-- Controles de accesibilidad -->
		<AccessibilityControls />
		
		<!-- Botón flotante para volver arriba -->
		<button 
			id="scroll-to-top" 
			class="btn-ripple fixed left-6 bottom-6 w-12 h-12 bg-blue-600 dark:bg-gray-800 text-white dark:text-gray-300 rounded-full shadow-lg hover:bg-blue-700 dark:hover:bg-gray-700 hover:scale-110 flex items-center justify-center z-[9998]"
			style="opacity: 0; pointer-events: none; transition: opacity 0.3s ease;"
			aria-label="Volver arriba"
		>
			<span class="material-icons">arrow_upward</span>
		</button>
		
		<!-- Sistema de temas (debe cargarse primero para evitar flash) -->
		<script is:inline src="/theme.js"></script>
		
		<!-- Sistema de traducciones del lado del cliente -->
		<script is:inline src="/i18n-client.js"></script>
		
		<!-- Sistema de animaciones al hacer scroll -->
		<script is:inline src="/scroll-animations.js"></script>
		
		<!-- Sistema de accesibilidad -->
		<script is:inline src="/accessibility.js"></script>
		
		<!-- Transiciones de idioma -->
		<script is:inline src="/language-transition.js"></script>
		
		<!-- Animaciones de texto -->
		<script is:inline src="/text-animations.js"></script>
		
		<!-- Visor de imágenes -->
		<script is:inline src="/image-viewer.js"></script>
		
		<!-- Previsualizaciones de enlaces en hover -->
		<script is:inline src="/link-preview.js"></script>
		
		<!-- Script para el botón de scroll y progress bar -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const scrollButton = document.getElementById('scroll-to-top');
				const scrollProgress = document.getElementById('scroll-progress');
				
				// Actualizar scroll progress y botón
				window.addEventListener('scroll', () => {
					// Progress bar
					if (scrollProgress) {
						const scrollTop = window.scrollY;
						const docHeight = document.documentElement.scrollHeight - window.innerHeight;
						const scrollPercent = (scrollTop / docHeight) * 100;
						scrollProgress.style.width = scrollPercent + '%';
					}
					
					// Botón de scroll
					if (scrollButton) {
						if (window.scrollY > 300) {
							scrollButton.style.opacity = '1';
							scrollButton.style.pointerEvents = 'auto';
						} else {
							scrollButton.style.opacity = '0';
							scrollButton.style.pointerEvents = 'none';
						}
					}
				});
				
				// Scroll suave al inicio
				if (scrollButton) {
					scrollButton.addEventListener('click', () => {
						window.scrollTo({
							top: 0,
							behavior: 'smooth'
						});
					});
				}
			});
		</script>
	</body>
</html>
