---
interface Props {
  icon: string;
  onClick?: string;
  href?: string;
  ariaLabel?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  rounded?: boolean;
  className?: string;
  id?: string;
}

const { 
  icon, 
  onClick, 
  href, 
  ariaLabel, 
  variant = 'secondary', 
  size = 'md',
  rounded = true,
  className = '',
  id
} = Astro.props;

const sizeClasses = {
  sm: 'p-2',
  md: 'p-3',
  lg: 'p-4'
};

const variantClasses = {
  primary: 'bg-blue-600 dark:bg-blue-500 text-white hover:bg-blue-700 dark:hover:bg-blue-600',
  secondary: 'bg-white dark:bg-gray-800 text-gray-900 dark:text-white border-2 border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400',
  ghost: 'bg-transparent text-gray-700 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400',
  dark: 'bg-gray-900 text-white hover:bg-gray-800'
};

const roundedClass = rounded ? 'rounded-full' : 'rounded-lg';

const Wrapper = href ? 'a' : 'button';
const wrapperProps = href 
  ? { href, ariaLabel, id } 
  : { onClick, ariaLabel, id };
---

<Wrapper 
  {...wrapperProps}
  class={`btn-ripple flex-shrink-0 flex items-center justify-center ${sizeClasses[size]} ${variantClasses[variant]} ${roundedClass} shadow-lg hover:shadow-xl hover:scale-110 active:scale-95 transition-all duration-300 ${className}`}
>
  <span class="material-icons text-xl md:text-2xl">{icon}</span>
</Wrapper>
