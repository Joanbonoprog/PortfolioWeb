---
interface Props {
  src: string;
  alt: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  rounded?: boolean;
  animate?: boolean;
  className?: string;
}

const { 
  src, 
  alt, 
  size = 'lg', 
  rounded = true, 
  animate = true,
  className = ''
} = Astro.props;

const sizeClasses = {
  sm: 'w-32 h-32',
  md: 'w-48 h-48',
  lg: 'w-60 h-60 md:w-72 md:h-72 lg:w-80 lg:h-80',
  xl: 'w-96 h-96'
};

const roundedClass = rounded ? 'rounded-full' : 'rounded-2xl';
const animateClass = animate ? 'hover:scale-105 hover:rotate-3' : '';
---

<div class={`${sizeClasses[size]} ${roundedClass} ${animateClass} mx-auto overflow-hidden shadow-2xl border-4 border-white dark:border-gray-700 transition-all duration-500 cursor-pointer group ${className}`}>
  <img 
    src={src} 
    alt={alt}
    fetchpriority="high"
    loading="eager"
    decoding="async"
    width="320"
    height="320"
    class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
    style="object-position: center 30%;" 
  />
</div>
