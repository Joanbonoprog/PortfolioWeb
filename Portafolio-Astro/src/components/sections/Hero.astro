---
import type { Translations } from '../../types/translations';
import ProfileImage from '../ui/ProfileImage.astro';
import ScrollIndicator from '../ui/ScrollIndicator.astro';

interface Props {
  translations: Translations;
  currentLang: string;
}

const { translations, currentLang } = Astro.props;
const { hero } = translations;
---

<section class="min-h-screen flex items-center justify-center px-6 pt-20 transition-colors duration-300">
  <div class="max-w-4xl mx-auto text-center">
    <div class="animate-fade-in" style="animation-delay: 0s;">
      <ProfileImage
        src="/images/hero/FotoPortfolio.webp"
        alt={hero.name}
        size="lg"
      />
    </div>

    <!-- Greeting -->
    <p class="text-xl text-gray-600 dark:text-gray-400 mb-4 animate-fade-in" style="animation-delay: 0.1s;">
      {hero.greeting}
    </p>

    <!-- Name -->
    <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-gray-900 dark:text-white mb-6 animate-fade-in" style="animation-delay: 0.2s;">
      {hero.name}
    </h1>

    <!-- Title with Typewriter Effect -->
    <h2 id="typewriter-title" class="text-2xl md:text-3xl lg:text-4xl text-indigo-600 dark:text-indigo-400 font-semibold mb-20 min-h-[3rem]">
      <span class="typewriter-text" data-text={hero.title}></span><span class="typewriter-cursor">|</span>
    </h2>

    <!-- Scroll Indicator -->
    <ScrollIndicator 
      href="#about" 
      ariaLabel={translations.ariaLabels.goToAbout}
      icon="keyboard_arrow_down"
      size="md"
      className="md:mt-16"
    />
  </div>
</section>

<script>
  // Efecto typewriter
  function initTypewriter() {
    const typewriterText = document.querySelector('.typewriter-text');
    
    if (!typewriterText) return;

    // Limpiar cualquier contenido previo
    typewriterText.textContent = '';

    // El título viene del SSR vía data-text (evita depender del orden de carga
    // de i18n-bootstrap); window.__i18n__ se mantiene como fallback.
    const text = typewriterText.getAttribute('data-text') || window.__i18n__?.hero?.title || '';
    let index = 0;
    
    function typeWriter() {
      if (index < text.length && typewriterText) {
        typewriterText.textContent += text.charAt(index);
        index++;
        setTimeout(typeWriter, 50);
      }
    }
    
    // Iniciar inmediatamente para evitar delay
    setTimeout(typeWriter, 300);
  }
  
  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTypewriter);
  } else {
    initTypewriter();
  }
</script>

<style>
  /* Cursor typewriter */
  .typewriter-cursor {
    animation: blink 1s step-end infinite;
    color: rgb(79, 70, 229); /* indigo-600 */
    text-shadow: 0 0 15px rgba(79, 70, 229, 0.7), 0 0 25px rgba(79, 70, 229, 0.4);
    font-weight: 600;
  }
  
  .dark .typewriter-cursor {
    color: rgb(129, 140, 248); /* indigo-400 */
    text-shadow: 0 0 18px rgba(129, 140, 248, 0.8), 0 0 30px rgba(129, 140, 248, 0.5);
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
</style>

